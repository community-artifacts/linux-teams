{
  "manifest_version": 2,
  "name": "Teams tray bridge",
  "version": "0.1.0",
  "description": "Reports the Teams unread count to the local tray app.",
  "browser_specific_settings": { "gecko": { "id": "teams-tray-bridge@community.local" } },
  "permissions": ["http://127.0.0.1:47653/*"],
  "content_scripts": [
    { "matches": ["https://teams.cloud.microsoft/*", "https://teams.microsoft.com/*"], "js": ["content.js"] }
  ],
  "background": { "scripts": ["background.js"] }
}
